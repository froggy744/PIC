  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>PIC — Personal Image Catalogue</name>
  <summary>Browse, organise and edit your photo collection</summary>
  <developer id="io.github.froggy744">
    <name>Petrus Rademeyer</name>
  </developer>
  <description>
    <p>PIC is a native photo manager inspired by Picasa and iPhoto. Browse local folders and network shares, organise your library, and work with your photos in one application.</p>
    <ul>
      <li>Browse photo grids and open images in the full-screen viewer.</li>
      <li>Organise photos with albums, favourites, ratings and search.</li>
      <li>Adjust photos with editing tools and create photo collages.</li>
      <li>Browse SMB and NFS shares using direct network transports.</li>
      <li>Choose an appearance theme for your workspace.</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.you.PicRs.desktop</launchable>
